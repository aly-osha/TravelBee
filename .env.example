# Core Settings
PORT=5000
NODE_ENV=development
JWT_SECRET=
# Must be set in every environment. Never commit a real value: .env.example is
# tracked in git, so anything written here is public.

# Database & Cache
MONGO_URI=mongodb://localhost:27017/travelbee
REDIS_URL=redis://localhost:6379

# Subservice Ports
REALTIME_PORT=5001
WEB_PORT=5173

# External APIs
# Placeholder only. Never commit a real key - this file is tracked in git.
# Supply the real value via your platform's secret store (Kubernetes
# secretKeyRef in infrastructure/kubernetes/), or a local .env that
# .gitignore already excludes.
MAPS_API_KEY=
